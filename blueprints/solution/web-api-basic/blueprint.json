{
  "schema_version": "1.0",
  "kind": "architecture_blueprint",
  "id": "web-api-basic",
  "version": "0.1.0",
  "name": "Web API baseline",
  "purpose": "Expose a small service with health and source revision.",
  "scope": {
    "included": [
      "capability",
      "service",
      "application",
      "team",
      "repository"
    ],
    "excluded": [
      "Provider credentials",
      "Runtime records and personal data"
    ]
  },
  "nodes": [
    {
      "key": "capability",
      "type": "capability",
      "name": "Capability"
    },
    {
      "key": "service",
      "type": "service",
      "name": "Service"
    },
    {
      "key": "application",
      "type": "application",
      "name": "Application"
    },
    {
      "key": "team",
      "type": "team",
      "name": "Team"
    },
    {
      "key": "repository",
      "type": "repository",
      "name": "Repository"
    }
  ],
  "relationships": [
    {
      "source": "service",
      "type": "service_implements_capability",
      "target": "capability"
    },
    {
      "source": "application",
      "type": "application_supports_service",
      "target": "service"
    },
    {
      "source": "application",
      "type": "application_owned_by_team",
      "target": "team"
    },
    {
      "source": "repository",
      "type": "repository_implements_application",
      "target": "application"
    }
  ],
  "viewpoints": [
    "system_context",
    "container"
  ],
  "decisions": [
    {
      "id": "deployment-target",
      "status": "open",
      "question": "Which runtime and quality constraints fit this architecture?"
    }
  ],
  "constraints": [
    "Confirm component identity before merging with an existing workspace.",
    "A model does not grant runtime permissions."
  ],
  "gaps": [],
  "deployable": false
}
